# LF in both repository and checkout keeps SHA-256 input bytes identical on all OSes.
# Any future active CRLF exception must explicitly declare eol=crlf here.
* text=auto eol=lf

# Archived originals, historical sources, fixtures and curated README media:
# preserve exact bytes, including existing CRLF in these frozen inputs.
*.step -text -diff
*.stp -text -diff
cad/vendor/**/vendor-model-* -text
cad/vendor/**/vendor-document-* -text
model/history/** -text
tests/fixtures/** -text
docs/media/** -text

# Native CAD, meshes and media are byte-preserved binary artifacts.
*.sc -text -diff
*.solidcraft -text -diff
*.stl -text -diff
*.FCStd binary
*.pdf binary
*.png binary
*.mp4 binary
