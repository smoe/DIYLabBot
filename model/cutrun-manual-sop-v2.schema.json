{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cutrun-manual-sop-v2.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sop", "base_protocol", "preflight", "recipe_protocol", "s09_phases"],
      "properties": {
        "format": {"const": "solidcraftbot.cutrun-manual-sop-protocol/2"},
        "sop": {"const": {"id": "SOP-CR-SKM29-H3K4me3", "revision": "0.1"}},
        "base_protocol": {"$ref": "#/$defs/reference"},
        "preflight": {"$ref": "#/$defs/reference"},
        "recipe_protocol": {"$ref": "#/$defs/reference"},
        "s09_phases": {"const": ["S09.extraction_lysis", "S09.input_preparation", "S09.supernatant_clarification"]}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "id", "mode", "protocol", "phase_requirements", "input_sonication"],
      "properties": {
        "format": {"const": "solidcraftbot.cutrun-manual-sop-profile/2"},
        "id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["manual_observation", "test_fixture"]},
        "protocol": {"$ref": "#/$defs/reference"},
        "phase_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["S09.extraction_lysis", "S09.input_preparation", "S09.supernatant_clarification"],
          "properties": {
            "S09.extraction_lysis": {"$ref": "#/$defs/phase"},
            "S09.input_preparation": {"$ref": "#/$defs/phase"},
            "S09.supernatant_clarification": {"$ref": "#/$defs/phase"}
          }
        },
        "input_sonication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_reaction_id", "device_instance_id", "sonicator_place_id", "cycles", "pulse_on_s",
            "between_pulses_s", "amplitude_percent", "fill_volume_ul", "plan_evidence_ref",
            "size_minimum_bp", "size_maximum_bp", "size_criteria_evidence_ref"
          ],
          "properties": {
            "input_reaction_id": {"$ref": "#/$defs/openIdentity"},
            "device_instance_id": {"$ref": "#/$defs/openIdentity"},
            "sonicator_place_id": {"$ref": "#/$defs/openIdentity"},
            "cycles": {"type": ["integer", "null"], "minimum": 1},
            "pulse_on_s": {"$ref": "#/$defs/openPositive"},
            "between_pulses_s": {"type": ["number", "null"], "minimum": 0},
            "amplitude_percent": {"$ref": "#/$defs/openPositive", "maximum": 100},
            "fill_volume_ul": {"$ref": "#/$defs/openPositive"},
            "plan_evidence_ref": {"$ref": "#/$defs/openIdentity"},
            "size_minimum_bp": {"$ref": "#/$defs/openPositive"},
            "size_maximum_bp": {"$ref": "#/$defs/openPositive"},
            "size_criteria_evidence_ref": {"$ref": "#/$defs/openIdentity"}
          }
        }
      }
    }
  ],
  "$defs": {
    "reference": {"$ref": "assembly-reference.schema.json#/$defs/reference"},
    "phase": {"$ref": "cutrun-manual-sop.profile.schema.json#/$defs/phaseRequirement"},
    "openIdentity": {"type": ["string", "null"], "minLength": 1},
    "openPositive": {"type": ["number", "null"], "exclusiveMinimum": 0}
  }
}
