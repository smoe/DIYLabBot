{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "equipment-layout.schema.json",
  "title": "Device sources and poses relative to named support frames",
  "type": "object",
  "required": [
    "format",
    "units",
    "assets",
    "instances"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "solidcraftbot.equipment-layout/1"
    },
    "units": {
      "const": {
        "length": "mm",
        "angle": "deg"
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "assembly-reference.schema.json#/$defs/reference"
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "$ref": "assembly-reference.schema.json#/$defs/equipment_instance"
      }
    }
  }
}
