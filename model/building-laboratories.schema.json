{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "building-laboratories.schema.json",
  "title": "Referenced laboratories bound to destination building rooms",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "laboratories"
  ],
  "properties": {
    "format": {
      "const": "solidcraftbot.building-laboratories/1"
    },
    "laboratories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "room",
          "level",
          "area",
          "entrance_wall",
          "room_source",
          "layout_source",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "room": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "entrance_wall": {
            "type": "string",
            "minLength": 1
          },
          "room_source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "source_sha256"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^model/.*\\.json$"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "layout_source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "source_sha256"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^model/.*\\.json$"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "basis": {
            "const": "unmeasured_room_binding"
          }
        }
      }
    },
    "basic_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_sha256"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^model/.*\\.json$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "basic_laboratories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "room",
          "area",
          "level",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "room": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "EG",
              "OG1",
              "OG2",
              "OG3"
            ]
          },
          "basis": {
            "const": "owner_confirmed_basic_furnishing_rule"
          },
          "ice_maker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source", "variant", "support", "front_inset_mm"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "source": {"$ref": "#/properties/basic_profile"},
              "variant": {"const": "countertop"},
              "support": {"type": "string", "minLength": 1},
              "front_inset_mm": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "excluded_rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "area",
          "usage",
          "basis"
        ],
        "properties": {
          "level": {
            "enum": [
              "EG",
              "OG1",
              "OG2",
              "OG3"
            ]
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "usage": {
            "enum": [
              "office",
              "storage",
              "kitchen",
              "secretariat",
              "non_laboratory"
            ]
          },
          "basis": {
            "const": "owner_confirmed"
          }
        }
      }
    }
  },
  "dependentRequired": {
    "basic_profile": [
      "basic_laboratories",
      "excluded_rooms"
    ],
    "basic_laboratories": [
      "basic_profile",
      "excluded_rooms"
    ]
  }
}
