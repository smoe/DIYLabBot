{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extraction-automation.schema.json",
  "title": "Preparation-only Qiagen cell-pellet RNA/DNA extraction contracts; no device execution",
  "oneOf": [
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/protocol"
    },
    {
      "$ref": "#/$defs/preparation"
    }
  ],
  "$defs": {
    "pinned_reference": {
      "allOf": [
        {
          "$ref": "assembly-reference.schema.json#/$defs/reference"
        },
        {
          "required": [
            "source_sha256"
          ],
          "propertyNames": {
            "enum": [
              "source",
              "source_sha256"
            ]
          }
        }
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "status",
        "references",
        "materials",
        "kits",
        "automation_reference"
      ],
      "properties": {
        "format": {
          "const": "solidcraftbot.extraction-catalog/1"
        },
        "status": {
          "const": "preparation_only"
        },
        "references": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "revision",
              "accessed_on",
              "scope"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://www\\.qiagen\\.com/"
              },
              "revision": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "\\S"
              },
              "accessed_on": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "materials": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "kind",
              "supply",
              "source_refs"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "kind": {
                "enum": [
                  "reagent",
                  "column",
                  "vessel",
                  "tip",
                  "holder"
                ]
              },
              "supply": {
                "enum": [
                  "kit",
                  "kit_or_protocol_selected",
                  "additional_protocol_specific"
                ]
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "kits": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manufacturer",
              "name",
              "catalog_number",
              "analyte",
              "method",
              "sample_classes",
              "source_refs",
              "roles",
              "additional_materials",
              "limitations"
            ],
            "properties": {
              "manufacturer": {
                "const": "QIAGEN"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "catalog_number": {
                "type": "string",
                "pattern": "^\\d+$"
              },
              "analyte": {
                "enum": [
                  "rna",
                  "dna"
                ]
              },
              "method": {
                "const": "silica_spin_column"
              },
              "sample_classes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "roles": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "additional_materials": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "limitations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "automation_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "status",
            "source_refs",
            "note"
          ],
          "properties": {
            "platform": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "status": {
              "const": "manufacturer_reference_only"
            },
            "source_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "mode",
        "operations",
        "parameter_units",
        "workflows",
        "integration_targets",
        "limitations"
      ],
      "properties": {
        "format": {
          "const": "solidcraftbot.extraction-preparation-protocol/1"
        },
        "mode": {
          "const": "preparation_only"
        },
        "operations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability",
              "purpose",
              "parameters",
              "retained_fraction"
            ],
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "parameters": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "volume_ul",
                    "duration_s",
                    "temperature_deg_c",
                    "rcf_x_g",
                    "cycles"
                  ]
                }
              },
              "retained_fraction": {
                "enum": [
                  "input",
                  "flow_through",
                  "column",
                  "eluate",
                  "product"
                ]
              }
            }
          }
        },
        "parameter_units": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "volume_ul",
            "duration_s",
            "temperature_deg_c",
            "rcf_x_g",
            "cycles"
          ],
          "properties": {
            "volume_ul": {
              "const": "uL"
            },
            "duration_s": {
              "const": "s"
            },
            "temperature_deg_c": {
              "const": "degC"
            },
            "rcf_x_g": {
              "const": "x_g"
            },
            "cycles": {
              "const": "count"
            }
          }
        },
        "workflows": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rna",
            "dna"
          ],
          "properties": {
            "rna": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kit_id",
                "steps",
                "source_refs"
              ],
              "properties": {
                "kit_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "source_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              }
            },
            "dna": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kit_id",
                "steps",
                "source_refs"
              ],
              "properties": {
                "kit_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "source_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              }
            }
          }
        },
        "integration_targets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lifecycle",
            "journal",
            "ledger",
            "qc_profiles"
          ],
          "properties": {
            "lifecycle": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "journal": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "ledger": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "qc_profiles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "id",
        "mode",
        "catalog",
        "protocol",
        "sample_class",
        "pairing_policy",
        "synthetic",
        "sample_pairs"
      ],
      "properties": {
        "format": {
          "const": "solidcraftbot.extraction-preparation/1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mode": {
          "const": "preparation_only"
        },
        "catalog": {
          "$ref": "#/$defs/pinned_reference"
        },
        "protocol": {
          "$ref": "#/$defs/pinned_reference"
        },
        "sample_class": {
          "const": "cultured_mammalian_cell_pellet"
        },
        "pairing_policy": {
          "const": "separate_input_aliquots"
        },
        "synthetic": {
          "const": true
        },
        "sample_pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin_id",
              "rna_input_id",
              "dna_input_id",
              "rna_product_id",
              "dna_product_id",
              "processes"
            ],
            "properties": {
              "origin_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "rna_input_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "dna_input_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "rna_product_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "dna_product_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "processes": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rna",
                  "dna"
                ],
                "properties": {
                  "rna": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/process"
                      },
                      {
                        "properties": {
                          "items": {
                            "required": [
                              "gdna_column",
                              "gdna_collection_vessel"
                            ]
                          }
                        }
                      }
                    ]
                  },
                  "dna": {
                    "$ref": "#/$defs/process"
                  }
                }
              }
            }
          }
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sop",
        "preservation_state",
        "input_amount",
        "parameter_values",
        "providers",
        "items",
        "output_location"
      ],
      "properties": {
        "sop": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision",
                "source"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source": {
                  "$ref": "#/$defs/pinned_reference"
                }
              }
            }
          ]
        },
        "preservation_state": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "input_amount": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "enum": [
                    "mg",
                    "cells"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "unit": {
                        "const": "cells"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "integer"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "parameter_values": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                  "volume_ul": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "exclusiveMinimum": 0
                  },
                  "duration_s": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "exclusiveMinimum": 0
                  },
                  "temperature_deg_c": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "rcf_x_g": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "exclusiveMinimum": 0
                  },
                  "cycles": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  }
                }
              }
            ]
          }
        },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_vessel",
            "binding_column",
            "collection_vessel",
            "elution_vessel"
          ],
          "properties": {
            "input_vessel": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "binding_column": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "collection_vessel": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "elution_vessel": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "gdna_column": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "gdna_collection_vessel": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "output_location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rack_id",
            "place_id"
          ],
          "properties": {
            "rack_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "place_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  }
}
