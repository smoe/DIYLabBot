  "network_batch": {
    "source": "model/cf01-rack-batch.protocol.json",
    "source_sha256": "da39b92cda9293858de7c5e7c096ce5ea1a6bd2a59743cf3b478f9a00e844681",
    "runner": "scripts/cf01_rack_batch.py",
    "limitations": [
      "Real TLS/gRPC against one synthetic station; no hardware spin or transporter execution",
      "Robot handoffs are explicit synthetic observations, not native trajectories, physical scans or qualified sensor feedback",
      "Masses and station qualification come from the fictitious batch fixture",
      "Interrupted or uncertain client runs require explicit reconciliation; no automatic job or sample-ledger replay"
    ]
  },
  "simulation_feature": {
    "identifier": "SyntheticRobotObservation",
    "version": "1.0",
    "description": "Simulation-only robot access observations. No hardware feedback override, motion execution or physical identity verification. There is no network clock control.",
    "command": "ObserveRobotAccess",
    "events": ["begin_loading", "begin_removal", "withdraw"],
    "parameters": [
      {"name": "boot_id", "type": "string", "description": "Expected current station boot UUID."},
      {"name": "observation_id", "type": "string", "description": "Unique UUID durably recorded before applying this synthetic observation."},
      {"name": "actor_id", "type": "string", "description": "Authenticated operator asserting the synthetic observation."},
      {"name": "sample_id", "type": "string", "description": "Echoed fixture identity, not a scan or sensor identification."},
      {"name": "slot", "type": "int64", "description": "Selected rotor slot; must match the confirmed station index."},
      {"name": "event", "type": "string", "description": "begin_loading, begin_removal or withdraw. Withdrawal requires matching access and completed station confirmation."}
    ],
    "errors": ["InvalidObservation", "DuplicateRequest", "RecoveryRequired", "PersistenceFailure"]
  },
  "state_fields": [
    {
      "name": "process_time_s",
      "type": "float64",
      "description": "Station process time in seconds from the current boot; the mock uses monotonic real time by default."
    },
    {
      "name": "recovery_required",
      "type": "bool",
      "description": "Explicit reconciliation or fault recovery is required before further process motion."
    },
    {
      "name": "clock_mode",
      "type": "string",
      "description": "monotonic_realtime or injected_manual; never a hardware timing claim."
    },
    {
      "name": "run_phase",
      "type": "string",
      "description": "Current centrifuge core run phase, or idle. Success follows braking and confirmed standstill."
    },
    {
      "name": "rotor_slots",
      "type": "list",
      "description": "Derived simulator slot observations, not a sample identity ledger or physical sensor evidence.",
      "element": {
        "type": "structure",
        "fields": [
          {"name": "slot", "type": "int64", "description": "One-based station slot."},
          {"name": "present", "type": "bool", "description": "Simulated tube presence."},
          {"name": "seated", "type": "bool", "description": "Simulated seated confirmation."},
          {"name": "mass_valid", "type": "bool", "description": "Whether MassG contains a known simulated mass."},
          {"name": "mass_g", "type": "float64", "description": "Simulated total tube mass in grams; zero is a placeholder only when MassValid is false."}
        ]
      }
    }
  ]
}
