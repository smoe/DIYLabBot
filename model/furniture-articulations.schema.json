{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "catalog",
    "types",
    "lab_joints"
  ],
  "properties": {
    "format": {
      "const": "solidcraftbot.furniture-articulations/1"
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_sha256"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "moving_parts",
            "hinge",
            "axis",
            "front",
            "limits_deg",
            "states",
            "reference_state",
            "basis",
            "qualification",
            "presentation"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "revolute"
            },
            "moving_parts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "hinge": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "part",
                "edge"
              ],
              "properties": {
                "part": {
                  "type": "string",
                  "minLength": 1
                },
                "edge": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "const": "min"
                    },
                    "y": {
                      "const": "max"
                    }
                  }
                }
              }
            },
            "axis": {
              "const": [
                0,
                0,
                1
              ]
            },
            "front": {
              "const": [
                0,
                1,
                0
              ]
            },
            "limits_deg": {
              "const": [
                0,
                90
              ]
            },
            "states": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "closed",
                "open"
              ],
              "properties": {
                "closed": {
                  "const": 0
                },
                "open": {
                  "const": 90
                }
              }
            },
            "reference_state": {
              "const": "closed"
            },
            "basis": {
              "const": "presentation_assumption"
            },
            "qualification": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "measured_hinge",
                "native_articulation",
                "swing_clearance_checked"
              ],
              "properties": {
                "measured_hinge": {
                  "const": false
                },
                "native_articulation": {
                  "const": false
                },
                "swing_clearance_checked": {
                  "const": false
                }
              }
            },
            "presentation": {
              "$ref": "#/$defs/presentation"
            }
          }
        }
      }
    },
    "lab_joints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revolute",
        "prismatic"
      ],
      "properties": {
        "revolute": {
          "$ref": "#/$defs/presentation"
        },
        "prismatic": {
          "$ref": "#/$defs/presentation"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Type-wide illustrative furniture articulations; native geometry remains static",
  "$defs": {
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "commands",
        "state_labels",
        "duration",
        "view_distance"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open",
            "close",
            "view"
          ],
          "properties": {
            "open": {
              "type": "string",
              "minLength": 1
            },
            "close": {
              "type": "string",
              "minLength": 1
            },
            "view": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "state_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "closed",
            "opening",
            "open",
            "closing"
          ],
          "properties": {
            "closed": {
              "type": "string",
              "minLength": 1
            },
            "opening": {
              "type": "string",
              "minLength": 1
            },
            "open": {
              "type": "string",
              "minLength": 1
            },
            "closing": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "range",
            "basis"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10
            },
            "unit": {
              "const": "s"
            },
            "range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 10
              }
            },
            "basis": {
              "const": "presentation_assumption"
            }
          }
        },
        "view_distance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "range",
            "basis"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 300,
              "maximum": 3000
            },
            "unit": {
              "const": "mm"
            },
            "range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 300,
                "maximum": 3000
              }
            },
            "basis": {
              "const": "presentation_assumption"
            }
          }
        }
      }
    }
  }
}
