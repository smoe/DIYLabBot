{
  "type": "object",
  "required": [
    "format",
    "catalog",
    "basis",
    "kitchen_template_mapping",
    "placement_policy",
    "rooms"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "solidcraftbot.building-furnishings/1"
    },
    "catalog": {
      "type": "object",
      "required": [
        "source",
        "source_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^model/"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "basis": {
      "type": "string"
    },
    "kitchen_template_mapping": {
      "type": "string"
    },
    "placement_policy": {
      "type": "string"
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "room",
          "level",
          "template_areas",
          "recipe",
          "local_extent_mm",
          "yaw_deg",
          "instances"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "room": {
            "type": "string",
            "pattern": "^[123]\\.[0-9]{3}$"
          },
          "level": {
            "enum": [
              "OG1",
              "OG2",
              "OG3"
            ]
          },
          "template_areas": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "recipe": {
            "enum": [
              "kitchen",
              "office"
            ]
          },
          "local_extent_mm": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "yaw_deg": {
            "type": "number"
          },
          "instances": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "xyz_mm",
                "yaw_deg"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "type": {
                  "type": "string"
                },
                "xyz_mm": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "yaw_deg": {
                  "type": "number"
                },
                "opening_anchor": {
                  "type": "object",
                  "required": [
                    "opening_id",
                    "area_id",
                    "side",
                    "jamb_gap_mm",
                    "height_mm"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "opening_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "area_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "side": {
                      "const": "interior_right"
                    },
                    "jamb_gap_mm": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "height_mm": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "parameter_overrides_mm": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "length",
                      "depth",
                      "height",
                      "top_t",
                      "leg_size",
                      "start_inset",
                      "end_inset",
                      "max_leg_span"
                    ]
                  },
                  "additionalProperties": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "wall_span": {
                  "type": "object",
                  "required": [
                    "area_id",
                    "wall_id",
                    "segment",
                    "back_gap_mm",
                    "opening_margin_mm",
                    "corner_owner"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "area_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "wall_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "segment": {
                      "enum": [
                        "full",
                        "before_opening",
                        "after_opening"
                      ]
                    },
                    "opening_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "back_gap_mm": {
                      "const": 0
                    },
                    "opening_margin_mm": {
                      "type": "number",
                      "minimum": 0
                    },
                    "corner_owner": {
                      "type": "boolean"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "segment": {
                            "const": "full"
                          }
                        }
                      },
                      "then": {
                        "not": {
                          "required": [
                            "opening_id"
                          ]
                        }
                      },
                      "else": {
                        "required": [
                          "opening_id"
                        ]
                      }
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": [
                      "wall_span"
                    ]
                  },
                  "then": {
                    "properties": {
                      "xyz_mm": {
                        "const": [
                          0,
                          0,
                          0
                        ]
                      },
                      "yaw_deg": {
                        "const": 0
                      },
                      "parameter_overrides_mm": {
                        "not": {
                          "required": [
                            "length"
                          ]
                        }
                      }
                    },
                    "not": {
                      "required": [
                        "opening_anchor"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "layout_basis": {
            "type": "string",
            "minLength": 1
          },
          "window_anchor": {
            "type": "object",
            "required": [
              "area_id",
              "wall_id",
              "table_instances",
              "table_gap_mm",
              "basis"
            ],
            "additionalProperties": false,
            "properties": {
              "area_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "wall_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "table_instances": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                }
              },
              "table_gap_mm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Nominal tabletop-to-window inner-face gap, presentation-scaled exactly once"
              },
              "basis": {
                "const": "presentation_assumption"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "window_anchor"
              ]
            },
            "then": {
              "properties": {
                "recipe": {
                  "const": "kitchen"
                }
              }
            }
          }
        ]
      }
    },
    "atrium_seating": {
      "type": "array",
      "items": {
        "$ref": "atrium-seating.schema.json"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "building-furnishings.schema.json"
}
