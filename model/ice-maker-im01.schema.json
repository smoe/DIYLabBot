{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ice Maker IM01 Shared Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "status", "units", "recipe", "parameters", "variants", "reference", "limitations"],
  "properties": {
    "format": {"const": "solidcraftbot.ice-maker/1"},
    "id": {"const": "IceMakerIM01"},
    "status": {"type": "string", "minLength": 1},
    "units": {"const": {"length": "mm"}},
    "recipe": {"const": "sloped_front_open_ice_bin_v1"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "foot_height", "service_height", "bin_height", "top_band", "side_wall", "front_wall", "rear_wall", "liner", "front_setback", "bin_floor", "bin_top", "opening_height", "sill", "panel_top", "total_height"],
      "properties": {
        "width": {"$ref": "#/$defs/driving"},
        "depth": {"$ref": "#/$defs/driving"},
        "foot_height": {"$ref": "#/$defs/driving"},
        "service_height": {"$ref": "#/$defs/driving"},
        "bin_height": {"$ref": "#/$defs/driving"},
        "top_band": {"$ref": "#/$defs/driving"},
        "side_wall": {"$ref": "#/$defs/driving"},
        "front_wall": {"$ref": "#/$defs/driving"},
        "rear_wall": {"$ref": "#/$defs/driving"},
        "liner": {"$ref": "#/$defs/driving"},
        "front_setback": {"$ref": "#/$defs/driving"},
        "bin_floor": {"$ref": "#/$defs/derived"},
        "bin_top": {"$ref": "#/$defs/derived"},
        "opening_height": {"$ref": "#/$defs/derived"},
        "sill": {"$ref": "#/$defs/derived"},
        "panel_top": {"$ref": "#/$defs/derived"},
        "total_height": {"$ref": "#/$defs/derived"}
      }
    },
    "variants": {
      "type": "object", "additionalProperties": false,
      "required": ["floor_standing", "countertop"],
      "properties": {
        "floor_standing": {
          "$ref": "#/$defs/variant",
          "properties": {"support": {"const": "floor"}, "overrides": {"const": {}}}
        },
        "countertop": {
          "$ref": "#/$defs/variant",
          "properties": {"support": {"const": "worktop"}, "overrides": {
            "type": "object", "required": ["bin_height"], "additionalProperties": false,
            "properties": {"bin_height": {"type": "number", "exclusiveMinimum": 0}}
          }}
        }
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["manufacturer", "model", "photo_sku", "photo_url", "specification_url", "scope"],
      "properties": {
        "manufacturer": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "photo_sku": {"type": "string", "minLength": 1},
        "photo_url": {"type": "string", "format": "uri"},
        "specification_url": {"type": "string", "format": "uri"},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["expression", "unit", "range", "description"],
      "properties": {
        "expression": {"type": ["number", "string"]},
        "unit": {"const": "mm"},
        "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "driving": {"$ref": "#/$defs/parameter", "properties": {"expression": {"type": "number", "exclusiveMinimum": 0}}},
    "derived": {"$ref": "#/$defs/parameter", "properties": {"expression": {"type": "string", "minLength": 1}}},
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "support", "overrides"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "support": {"enum": ["floor", "worktop"]},
        "overrides": {"type": "object"}
      }
    }
  }
}
