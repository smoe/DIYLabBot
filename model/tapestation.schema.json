            "expression": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "const": "mm"
            },
            "range": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "top_clearance": {
