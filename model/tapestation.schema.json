{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tapestation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "status",
    "units",
    "operation",
    "handling",
    "selected_model",
    "planning_reference",
    "capabilities",
    "assay",
    "robot_loading_implemented",
    "result_import_implemented",
    "parameters",
    "references",
    "limitations",
    "human_assistance"
  ],
  "properties": {
    "format": {
      "const": "solidcraftbot.tapestation/1"
    },
    "id": {
      "const": "TS01"
    },
    "status": {
      "const": "Manual QC workplace; 4200 planning envelope, article selection open"
    },
    "units": {
      "const": {
        "length": "mm",
        "angle": "deg"
      }
    },
    "operation": {
      "const": "manual_instrument_envelope_on_reference_bench/1"
    },
    "handling": {
      "const": "manual_only"
    },
    "selected_model": {
      "const": null
    },
    "planning_reference": {
      "const": "4200 TapeStation"
    },
    "capabilities": {
      "const": [
        "dna_rna_electrophoresis_qc"
      ]
    },
    "assay": {
      "const": null
    },
    "robot_loading_implemented": {
      "const": false
    },
    "result_import_implemented": {
      "const": false
    },
