{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smoe/DIYLabBot/model/cf01-open-lid-index.schema.json",
  "title": "CF01 opt-in simulation-only open-lid indexing contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "sources",
    "simulation_only",
    "safety_qualified",
    "command",
    "limits",
    "bindings",
    "limitations"
  ],
  "properties": {
    "format": {
      "const": "solidcraftbot.cf01-open-lid-index-protocol/1"
    },
    "id": {
      "const": "CF01.index_open_lid"
    },
    "simulation_only": {
      "const": true
    },
    "safety_qualified": {
      "const": false
    },
    "command": {
      "const": {
        "id": "index_open_lid",
        "arguments": {
          "slot": {
            "type": "integer",
            "minimum": 1,
            "maximum_reference": {
              "source": "station",
              "path": [
                "rotor",
                "slots"
              ]
            }
          }
        },
        "preconditions": [
          "owner",
          "no_latched_fault",
          "_still",
          "_clear",
          "_parked",
          "open_lid_held"
        ],
        "effect": "Same rotor/encoder/parking-brake indexing effect as the existing index command; preserve the open held lid."
      }
    },
    "limits": {
      "const": {
        "index_speed_rpm": {
          "source": "station",
          "path": [
            "handling",
            "index_limit_rpm"
          ],
          "unit": "rpm"
        }
      }
    },
    "bindings": {
      "const": {
        "standard_simulator": false,
        "MockProtocol": false,
        "ros2": false,
        "sila2": false,
        "hardware": false
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "station",
        "protocol"
      ],
      "properties": {
        "station": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "source_sha256"
          ],
          "properties": {
            "source": {
              "const": "model/centrifuge-cf01.shared.json"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "source_sha256"
          ],
          "properties": {
            "source": {
              "const": "model/centrifuge-cf01.protocol.json"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
