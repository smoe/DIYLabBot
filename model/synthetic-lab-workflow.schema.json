{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidcraftbot.local/schema/synthetic-lab-workflow.schema.json",
  "title": "Synthetic CF01 / NanoDrop / Qubit workflow composition",
  "type": "object",
  "required": [
    "format",
    "id",
    "mode",
    "units",
    "clock_mode",
    "task_deadline_s",
    "manifest",
    "workspace",
    "bindings",
    "stage_order",
    "stage_profiles",
    "qubit_place_roles",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "solidcraftbot.synthetic-lab-workflow/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "synthetic_only"
    },
    "units": {
      "const": {
        "volume": "uL",
        "mass": "g",
        "time": "s"
      }
    },
    "clock_mode": {
      "const": "synthetic_events/1"
    },
    "task_deadline_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "manifest": {
      "$ref": "#/$defs/reference"
    },
    "workspace": {
      "$ref": "#/$defs/reference"
    },
    "bindings": {
      "type": "object",
      "required": [
        "rack_instance",
        "arm_instance",
        "station_instance",
        "work_area"
      ],
      "additionalProperties": false,
      "properties": {
        "rack_instance": {
          "const": "Rack"
        },
        "arm_instance": {
          "const": "Arm"
        },
        "station_instance": {
          "const": "CF01"
        },
        "work_area": {
          "type": "object",
          "required": [
            "id",
            "frame"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "SYN.NanoDrop.WorkArea"
            },
            "frame": {
              "const": "SYN.Bench.Worktop"
            }
          }
        }
      }
    },
    "stage_order": {
      "const": [
        "cf01",
        "nanodrop",
        "qubit"
      ]
    },
    "stage_profiles": {
      "type": "object",
      "required": [
        "cf01",
        "nanodrop",
        "qubit"
      ],
      "additionalProperties": false,
      "properties": {
        "cf01": {
          "$ref": "#/$defs/reference"
        },
        "nanodrop": {
          "$ref": "#/$defs/reference"
        },
        "qubit": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "qubit_place_roles": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/place_role"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "source",
        "source_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^model/.+\\.json$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sample": {
      "type": "object",
      "required": [
        "sample_id",
        "vessel_id",
        "rack_place_id",
        "initial_volume_ul"
      ],
      "additionalProperties": false,
      "properties": {
        "sample_id": {
          "type": "string",
          "minLength": 1
        },
        "vessel_id": {
          "type": "string",
          "minLength": 1
        },
        "rack_place_id": {
          "type": "string",
          "pattern": "^Slot(0[1-9]|1[0-2])$"
        },
        "initial_volume_ul": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "format",
        "id",
        "rack_instance",
        "samples"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "solidcraftbot.synthetic-lab-manifest/1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rack_instance": {
          "const": "Rack"
        },
        "samples": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/sample"
          }
        }
      }
    },
    "place_role": {
      "type": "object",
      "required": [
        "holder_id",
        "place_id",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "holder_id": {
          "type": "string",
          "minLength": 1
        },
        "place_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "holder_slot",
            "measurement_chamber"
          ]
        }
      }
    },
    "mass_confirmation": {
      "description": "New integrated runtime confirmation; content revision and current time are checked by the coordinator. Not a native scale reading.",
      "type": "object",
      "required": [
        "confirmation_id",
        "vessel_id",
        "mass_g",
        "content_revision",
        "actor_id",
        "time_s",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "confirmation_id": {
          "type": "string",
          "minLength": 1
        },
        "vessel_id": {
          "type": "string",
          "minLength": 1
        },
        "mass_g": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "content_revision": {
          "type": "integer",
          "minimum": 0
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "time_s": {
          "type": "number",
          "minimum": 0
        },
        "evidence": {
          "const": "synthetic_input"
        }
      }
    }
  }
}
