{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab-glassware.schema.json",
  "title": "Portable laboratory glassware library with shared family recipes",
  "type": "object", "additionalProperties": false,
  "required": ["format", "id", "units", "status", "material", "references", "families", "closures", "items", "limitations"],
  "properties": {
    "format": {"const": "solidcraftbot.lab-glassware/2"},
    "id": {"type": "string", "minLength": 1},
    "units": {"const": {"length": "mm", "angle": "deg", "volume": "mL"}},
    "status": {"type": "string", "minLength": 1},
    "material": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "measured_density_g_per_ml", "measured_empty_mass_g"],
      "properties": {"family": {"const": "borosilicate_glass"}, "measured_density_g_per_ml": {"type": "null"}, "measured_empty_mass_g": {"type": "null"}}
    },
    "references": {"type": "object", "additionalProperties": {"$ref": "#/$defs/reference"}},
    "families": {
      "type": "object", "additionalProperties": false, "required": ["beaker", "funnel", "bottle", "measuring_cylinder"],
      "properties": {"beaker": {"$ref": "#/$defs/family"}, "funnel": {"$ref": "#/$defs/family"}, "bottle": {"$ref": "#/$defs/family"}, "measuring_cylinder": {"$ref": "#/$defs/family"}}
    },
    "closures": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/closure"}},
    "items": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"}, "additionalProperties": {"$ref": "#/$defs/item"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "parameter": {
      "type": "object", "additionalProperties": false, "required": ["expression", "unit", "range", "description"],
      "properties": {
        "expression": {"type": ["number", "string"]}, "unit": {"const": "mm"},
        "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "family": {
      "type": "object", "additionalProperties": false, "required": ["recipe", "parameters", "sizes"],
      "properties": {
        "recipe": {"enum": ["hollow_beaker_with_pour_spout/1", "open_conical_funnel_with_continuous_stem/1", "hollow_shoulder_bottle_with_removable_closure/1", "hollow_measuring_cylinder_with_hexagonal_foot/1"]},
        "parameters": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"}, "additionalProperties": {"$ref": "#/$defs/parameter"}},
        "sizes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/size"}}
      }
    },
    "size": {
      "type": "object", "additionalProperties": false, "required": ["nominal_volume_ml", "overrides"],
      "properties": {"nominal_volume_ml": {"type": ["number", "null"], "exclusiveMinimum": 0}, "overrides": {"type": "object", "additionalProperties": {"type": "number"}}}
    },
    "closure": {
      "type": "object", "additionalProperties": false, "required": ["kind", "recipe", "parameters"],
      "properties": {"kind": {"enum": ["screw_cap", "glass_stopper"]},
        "recipe": {"enum": ["removable_screw_cap_envelope/1", "removable_glass_stopper_envelope/1"]},
        "parameters": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/parameter"}}}
    },
    "marker_label": {
      "description": "Optional per-instance permanent-marker annotation, outside catalog identity and inventory.",
      "type": "object", "additionalProperties": false, "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 80,
          "allOf": [{"pattern": "^[A-Za-z0-9ÄÖÜäöüßµ .,:;_%#?+()/=\\[\\]\\-\\n]+$"}, {"pattern": "\\S"}, {"not": {"pattern": "\\n[^\\n]*\\n[^\\n]*\\n"}}]},
        "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "height_mm": {"type": "number", "minimum": 2, "maximum": 12},
        "line_width_mm": {"type": "number", "minimum": 0.1, "maximum": 1}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "size", "label", "closure", "reference"],
      "properties": {
        "family": {"enum": ["beaker", "funnel", "bottle", "measuring_cylinder"]},
        "size": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1},
        "closure": {"type": "string", "minLength": 1}, "reference": {"type": ["string", "null"]}
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "accessed", "manufacturer", "part", "description", "nominal_volume_ml", "reference_graduations_ml", "outer_dimensions_mm"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"}, "accessed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "verified_url": {"type": "string", "pattern": "^https://"},
        "manufacturer": {"type": "string", "minLength": 1}, "part": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1},
        "nominal_volume_ml": {"type": "number", "exclusiveMinimum": 0},
        "outer_dimensions_mm": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
          "required": ["height", "diameter", "base_across_flats"],
          "properties": {"height": {"type": ["number", "null"], "exclusiveMinimum": 0}, "diameter": {"type": ["number", "null"], "exclusiveMinimum": 0}, "base_across_flats": {"type": ["number", "null"], "exclusiveMinimum": 0}}}]},
        "reference_graduations_ml": {"type": "object", "additionalProperties": false, "required": ["first", "last", "step"], "properties": {"first": {"type": ["number", "null"], "exclusiveMinimum": 0}, "last": {"type": "number", "exclusiveMinimum": 0}, "step": {"type": "number", "exclusiveMinimum": 0}}}
      }
    }
  }
}
