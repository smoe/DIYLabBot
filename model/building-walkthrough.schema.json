{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "building-walkthrough.schema.json",
  "title": "Source-bound furnished building viewpoints and illustrative interactions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "sources",
    "settings",
    "default_stop",
    "stops",
    "qualification",
    "limitations",
    "rendering",
    "articulation_source",
    "objects",
    "interaction",
    "elevator",
    "mechanisms",
    "navigation"
  ],
  "properties": {
    "format": {
      "const": "solidcraftbot.building-walkthrough/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "building"
      ],
      "properties": {
        "building": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "source_sha256"
          ],
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^model/.*\\.json$"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eye_height_mm",
        "walk_speed_mm_s",
        "vertical_speed_mm_s",
        "fov_deg",
        "near_mm",
        "far_mm",
        "look_sensitivity"
      ],
      "properties": {
        "eye_height_mm": {
          "type": "number",
          "minimum": 1000,
          "maximum": 2200
        },
        "walk_speed_mm_s": {
          "type": "number",
          "minimum": 100,
          "maximum": 4000
        },
        "vertical_speed_mm_s": {
          "type": "number",
          "minimum": 100,
          "maximum": 4000
        },
        "fov_deg": {
          "type": "number",
          "minimum": 35,
          "maximum": 100
        },
        "near_mm": {
          "type": "number",
          "minimum": 5,
          "maximum": 100
        },
        "far_mm": {
          "type": "number",
          "minimum": 30000,
          "maximum": 300000
        },
        "look_sensitivity": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 0.02
        }
      }
    },
    "default_stop": {
      "type": "string",
      "minLength": 1
    },
    "stops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "scene",
          "level_id",
          "anchor"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "scene": {
            "const": "building"
          },
          "level_id": {
            "enum": [
              "KG",
              "EG",
              "OG1",
              "OG2",
              "OG3"
            ]
          },
          "anchor": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "areas",
                  "opening",
                  "inset_mm",
                  "target_height_mm",
                  "look_at"
                ],
                "properties": {
                  "kind": {
                    "const": "room_entry"
                  },
                  "areas": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "opening": {
                    "type": "string",
                    "minLength": 1
                  },
                  "inset_mm": {
                    "type": "number",
                    "minimum": 300,
                    "maximum": 3000
                  },
                  "target_height_mm": {
                    "type": "number",
                    "minimum": 100,
                    "maximum": 2200
                  },
                  "look_at": {
                    "enum": [
                      "room_end",
                      "entry"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "area",
                  "wall",
                  "target_area",
                  "setback_mm",
                  "target_height_mm"
                ],
                "properties": {
                  "kind": {
                    "const": "area_edge"
                  },
                  "area": {
                    "type": "string",
                    "minLength": 1
                  },
                  "wall": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target_area": {
                    "type": "string",
                    "minLength": 1
                  },
                  "setback_mm": {
                    "type": "number",
                    "minimum": 300,
                    "maximum": 3000
                  },
                  "target_height_mm": {
                    "type": "number",
                    "minimum": 100,
                    "maximum": 2200
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "access_id",
                  "setback_mm",
                  "target_height_mm"
                ],
                "properties": {
                  "kind": {
                    "const": "access_entry"
                  },
                  "access_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "setback_mm": {
                    "type": "number",
                    "minimum": 300,
                    "maximum": 1500
                  },
                  "target_height_mm": {
                    "type": "number",
                    "minimum": 100,
                    "maximum": 2200
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "station",
                  "eye_offset_mm",
                  "target_height_mm"
                ],
                "properties": {
                  "kind": {
                    "const": "microscopy"
                  },
                  "station": {
                    "type": "string",
                    "minLength": 1
                  },
                  "eye_offset_mm": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": -2000,
                      "maximum": 2000
                    }
                  },
                  "target_height_mm": {
                    "type": "number",
                    "minimum": 100,
                    "maximum": 2200
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "station",
                  "opening",
                  "inset_mm",
                  "target_height_mm"
                ],
                "properties": {
                  "kind": {
                    "const": "kitchenette"
                  },
                  "station": {
                    "type": "string",
                    "minLength": 1
                  },
                  "opening": {
                    "type": "string",
                    "minLength": 1
                  },
                  "inset_mm": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 600
                  },
                  "target_height_mm": {
                    "type": "number",
                    "minimum": 100,
                    "maximum": 2200
                  }
                }
              }
            ]
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_scale_known",
        "lab_to_building_registered",
        "collision_checked"
      ],
      "properties": {
        "metric_scale_known": {
          "const": false
        },
        "lab_to_building_registered": {
          "const": false
        },
        "collision_checked": {
          "const": false
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opacity_by_role"
      ],
      "properties": {
        "opacity_by_role": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concept_storey_wall",
            "circulation_wall_bridge"
          ],
          "properties": {
            "concept_storey_wall": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1
            },
            "circulation_wall_bridge": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1
            }
          }
        }
      }
    },
    "articulation_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_sha256"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "room",
          "instance",
          "articulation",
          "label",
          "commands",
          "state_labels",
          "duration",
          "view_distance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*){2}$"
          },
          "room": {
            "type": "string",
            "minLength": 1
          },
          "instance": {
            "type": "string",
            "minLength": 1
          },
          "articulation": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "commands": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "open",
              "close",
              "view"
            ],
            "properties": {
              "open": {
                "type": "string",
                "minLength": 1
              },
              "close": {
                "type": "string",
                "minLength": 1
              },
              "view": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "state_labels": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "closed",
              "opening",
              "open",
              "closing"
            ],
            "properties": {
              "closed": {
                "type": "string",
                "minLength": 1
              },
              "opening": {
                "type": "string",
                "minLength": 1
              },
              "open": {
                "type": "string",
                "minLength": 1
              },
              "closing": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "duration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit",
              "range",
              "basis"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "unit": {
                "const": "s"
              },
              "range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "basis": {
                "const": "presentation_assumption"
              }
            }
          },
          "view_distance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit",
              "range",
              "basis"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "unit": {
                "const": "mm"
              },
              "range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "basis": {
                "const": "presentation_assumption"
              }
            }
          }
        }
      }
    },
    "interaction": {
      "type": "object",
      "required": [
        "reach"
      ],
      "additionalProperties": false,
      "properties": {
        "reach": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "range",
            "basis"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "const": "mm"
            },
            "range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "basis": {
              "const": "presentation_assumption"
            }
          }
        }
      }
    },
    "elevator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "speed"
      ],
      "properties": {
        "id": {
          "const": "BuildingLift"
        },
        "speed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "range",
            "basis"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 100,
              "maximum": 3000
            },
            "unit": {
              "const": "mm/s"
            },
            "range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 100,
                "maximum": 3000
              }
            },
            "basis": {
              "const": "presentation_assumption"
            }
          }
        },
        "door_duration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "range",
            "basis"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10
            },
            "unit": {
              "const": "s"
            },
            "range": {
              "const": [
                0.1,
                10
              ]
            },
            "basis": {
              "const": "presentation_assumption"
            }
          }
        }
      }
    },
    "mechanisms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room_doors",
        "equipment"
      ],
      "properties": {
        "room_doors": {
          "$ref": "#/$defs/mechanism_presentation"
        },
        "equipment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "freezer_minus20",
            "fume_hood_1200",
            "nanodrop",
            "qubit"
          ],
          "properties": {
            "fridge_4c": {
              "$ref": "#/$defs/cold_storage_mechanism"
            },
            "ice_maker_im01": {
              "$ref": "#/$defs/cold_storage_mechanism",
              "not": {"required": ["initial_state"]}
            },
            "freezer_minus20": {
              "$ref": "#/$defs/cold_storage_mechanism"
            },
            "fume_hood_1200": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "presentation",
                "roles"
              ],
              "properties": {
                "presentation": {
                  "$ref": "#/$defs/mechanism_presentation"
                },
                "roles": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "nanodrop": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "presentation",
                "roles"
              ],
              "properties": {
                "presentation": {
                  "$ref": "#/$defs/mechanism_presentation"
                },
                "roles": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "qubit": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "presentation",
                "roles"
              ],
              "properties": {
                "presentation": {
                  "$ref": "#/$defs/mechanism_presentation"
                },
                "roles": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_radius_mm",
        "contact_margin_mm",
        "max_contact_iterations",
        "max_slides",
        "closed_access_areas",
        "basis"
      ],
      "properties": {
        "camera_radius_mm": {
          "type": "number",
          "minimum": 20,
          "maximum": 400
        },
        "contact_margin_mm": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "max_contact_iterations": {
          "type": "integer",
          "minimum": 16,
          "maximum": 128
        },
        "max_slides": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "closed_access_areas": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "basis": {
          "const": "presentation_assumption"
        }
      }
    }
  },
  "$defs": {
    "cold_storage_mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation", "roles"],
      "properties": {
        "presentation": {"$ref": "#/$defs/mechanism_presentation"},
        "roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "initial_state": {"const": "closed"}
      }
    },
    "mechanism_presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "commands",
        "state_labels",
        "duration",
        "view_distance"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open",
            "close",
            "view"
          ],
          "properties": {
            "open": {
              "type": "string",
              "minLength": 1
            },
            "close": {
              "type": "string",
              "minLength": 1
            },
            "view": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "state_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "closed",
            "opening",
            "open",
            "closing"
          ],
          "properties": {
            "closed": {
              "type": "string",
              "minLength": 1
            },
            "opening": {
              "type": "string",
              "minLength": 1
            },
            "open": {
              "type": "string",
              "minLength": 1
            },
            "closing": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "range",
            "basis"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10
            },
            "unit": {
              "const": "s"
            },
            "range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 10
              }
            },
            "basis": {
              "const": "presentation_assumption"
            }
          }
        },
        "view_distance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "range",
            "basis"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 300,
              "maximum": 3000
            },
            "unit": {
              "const": "mm"
            },
            "range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 300,
                "maximum": 3000
              }
            },
            "basis": {
              "const": "presentation_assumption"
            }
          }
        }
      }
    }
  }
}
