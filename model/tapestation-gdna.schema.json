{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tapestation-gdna.schema.json",
  "title": "Explicit synthetic TS01 Genomic DNA ScreenTape reference and result contracts",
  "$ref": "#/$defs/protocol",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measurement_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "lane_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "sample_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "product_material_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "product_vessel_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "aliquot_material_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "aliquot_vessel_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "product_content_revision": {
          "type": "integer",
          "minimum": 0
        },
        "aliquot_content_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "measurement_id",
        "lane_id",
        "sample_id",
        "product_material_id",
        "product_vessel_id",
        "aliquot_material_id",
        "aliquot_vessel_id",
        "product_content_revision",
        "aliquot_content_revision"
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "instrument_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "analysis_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "instrument_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "assay_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "assay_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 96,
          "items": {
            "$ref": "#/$defs/identity"
          }
        }
      },
      "required": [
        "workflow_run_id",
        "instrument_run_id",
        "analysis_id",
        "instrument_id",
        "assay_id",
        "assay_revision",
        "measurements"
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "solidcraftbot.synthetic-tapestation-report/1"
        },
        "synthetic": {
          "const": true
        },
        "workflow_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "instrument_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "analysis_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "instrument_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "assay_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "assay_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,160}$"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 96,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "measurement_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,160}$"
              },
              "lane_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,160}$"
              },
              "sample_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,160}$"
              },
              "product_material_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,160}$"
              },
              "product_vessel_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,160}$"
              },
              "aliquot_material_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,160}$"
              },
              "aliquot_vessel_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,160}$"
              },
              "product_content_revision": {
                "type": "integer",
                "minimum": 0
              },
              "aliquot_content_revision": {
                "type": "integer",
                "minimum": 0
              },
              "din": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 10
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sample_concentration_ng_ul": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fragment_size": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit": {
                    "const": "bp"
                  },
                  "method": {
                    "enum": [
                      "peak",
                      "smear_mean"
                    ]
                  },
                  "qualifier": {
                    "enum": [
                      "estimated",
                      "above_sizing_range",
                      "unavailable"
                    ]
                  }
                },
                "required": [
                  "value",
                  "unit",
                  "method",
                  "qualifier"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "qualifier": {
                          "const": "estimated"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "value": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "value": {
                          "type": "null"
                        }
                      }
                    }
                  }
                ]
              },
              "flags": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "messages": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            },
            "required": [
              "measurement_id",
              "lane_id",
              "sample_id",
              "product_material_id",
              "product_vessel_id",
              "aliquot_material_id",
              "aliquot_vessel_id",
              "product_content_revision",
              "aliquot_content_revision",
              "din",
              "sample_concentration_ng_ul",
              "fragment_size",
              "flags",
              "messages"
            ]
          }
        }
      },
      "required": [
        "format",
        "synthetic",
        "workflow_run_id",
        "instrument_run_id",
        "analysis_id",
        "instrument_id",
        "assay_id",
        "assay_revision",
        "rows"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_din": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "minimum_fragment_size_bp": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "minimum_din",
        "minimum_fragment_size_bp"
      ]
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "solidcraftbot.tapestation-gdna-protocol/1"
        },
        "id": {
          "const": "TS01.GenomicDNA.ScreenTape"
        },
        "mode": {
          "const": "synthetic_only"
        },
        "instrument": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "TS01"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "const": "model/tapestation.shared.json"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "source",
                "source_sha256"
              ]
            },
            "planning_reference": {
              "const": "4200 TapeStation"
            },
            "selected_model": {
              "type": "null"
            },
            "handling": {
              "const": "manual_only"
            }
          },
          "required": [
            "id",
            "source",
            "planning_reference",
            "selected_model",
            "handling"
          ]
        },
        "assay": {
          "const": {
            "id": "GenomicDNA.ScreenTape",
            "revision": "SYN.1",
            "screentape_part_number": "5067-5365",
            "reagents_part_number": "5067-5366",
            "applicable_models": [
              "4150",
              "4200"
            ],
            "sample_volume_ul": 1.0,
            "sample_buffer_volume_ul": 10.0,
            "ladder_volume_ul": 1.0,
            "ladder_buffer_volume_ul": 10.0,
            "ladder_position": "A1",
            "fixture_sample_position": "A2",
            "ladder_fixture_scope": "one_or_two_screentape_devices",
            "references": {
              "sizing_lower_bp": 200,
              "sizing_upper_reference_bp": 60000,
              "sizing_upper_open": true,
              "sizing_accuracy_precision_lower_bp": 200,
              "sizing_accuracy_precision_upper_bp": 15000,
              "quantitative_lower_ng_ul": 10,
              "quantitative_upper_ng_ul": 100,
              "din_functional_lower_ng_ul": 5,
              "din_functional_upper_ng_ul": 300,
              "din_min": 1,
              "din_max": 10
            },
            "preparation": {
              "buffer_equilibration_s": 1800,
              "mix_duration_s": 60,
              "mix_rpm": 2000,
              "spin_duration_s": 60
            }
          }
        },
        "report_format": {
          "const": "solidcraftbot.synthetic-tapestation-report/1"
        },
        "limits": {
          "const": {
            "max_report_bytes": 262144,
            "max_rows": 96,
            "max_messages_per_row": 32,
            "max_message_characters": 2048
          }
        },
        "known_flags": {
          "const": [
            "analysis_failed",
            "ladder_failed",
            "sizing_out_of_range",
            "din_unavailable",
            "concentration_out_of_range",
            "user_flagged"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "url",
              "revision",
              "scope"
            ]
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "format",
        "id",
        "mode",
        "instrument",
        "assay",
        "report_format",
        "limits",
        "known_flags",
        "sources",
        "limitations"
      ]
    }
  }
}
