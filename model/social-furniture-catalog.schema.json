{
  "type": "object",
  "required": [
    "format",
    "units",
    "status",
    "types"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "solidcraftbot.social-furniture-catalog/1"
    },
    "units": {
      "const": {
        "length": "mm",
        "angle": "deg"
      }
    },
    "status": {
      "type": "string"
    },
    "types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
