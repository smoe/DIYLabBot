                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "origin",
                        "radius",
                        "height"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "cylinder"
                        },
                        "origin": {
                          "type": "array",
                          "minItems": 3,
                          "maxItems": 3,
                          "items": {
                            "type": "number"
                          }
                        },
                        "radius": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "height": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "origin",
                        "radius"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "sphere"
                        },
                        "origin": {
                          "type": "array",
                          "minItems": 3,
                          "maxItems": 3,
                          "items": {
                            "type": "number"
                          }
                        },
                        "radius": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "plane",
                        "points",
                        "offset",
                        "depth",
                        "fixed"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "polygon_prism"
                        },
                        "plane": {
                          "const": "XY"
                        },
                        "points": {
                          "type": "array",
                          "minItems": 3,
                          "items": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": {
                              "type": "number"
                            }
                          }
                        },
                        "offset": {
                          "type": "number"
                        },
                        "depth": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "fixed": {
                          "const": true
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "origin",
                        "radius",
                        "height",
                        "top_radius"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "cone"
                        },
                        "origin": {
                          "type": "array",
                          "minItems": 3,
                          "maxItems": 3,
                          "items": {
                            "type": "number"
                          }
                        },
                        "radius": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "height": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "top_radius": {
                          "type": "number",
                          "minimum": 0
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "extends",
              "omit_parts",
              "parts"
