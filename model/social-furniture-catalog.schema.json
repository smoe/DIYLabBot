                      "properties": {
                        "kind": {
                          "const": "box"
                        },
                        "origin": {
                          "type": "array",
                          "minItems": 3,
                          "maxItems": 3,
                          "items": {
                            "type": "number"
                          }
                        },
                        "size": {
                          "type": "array",
