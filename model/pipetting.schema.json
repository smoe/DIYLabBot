{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipetting.schema.json",
  "title": "PS01 station, labware, referenced setup and planning-only liquid-handling protocol",
  "oneOf": [
    {
      "$ref": "#/$defs/station"
    },
    {
      "$ref": "#/$defs/labware"
    },
    {
      "$ref": "#/$defs/setup"
    },
    {
      "$ref": "#/$defs/protocol"
    }
  ],
  "$defs": {
    "station": {
      "type": "object",
      "required": [
        "format",
        "id",
        "revision",
        "date",
        "status",
        "units",
        "recipe",
        "parameters",
        "grid",
        "tool_capabilities",
        "qualifications",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "solidcraftbot.pipetting-station/1"
        },
        "id": {
          "const": "PipettingStation_PS01"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "const": "Concept; no manufacturing release"
        },
        "units": {
          "const": {
            "length": "mm",
            "angle": "deg"
          }
        },
        "recipe": {
          "const": "nine_bay_open_pipetting_deck/1"
        },
        "parameters": {
          "type": "object",
          "required": [
            "deck_w",
            "deck_d",
            "deck_t",
            "pitch_x",
            "pitch_y",
            "bay_w",
            "bay_d",
            "pad_t"
          ],
          "additionalProperties": false,
          "properties": {
            "deck_w": {
              "type": "object",
              "required": [
                "expression",
                "unit",
                "range",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "expression": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "unit": {
                  "const": "mm"
                },
                "range": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "deck_d": {
              "type": "object",
              "required": [
                "expression",
                "unit",
                "range",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "expression": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "unit": {
                  "const": "mm"
                },
                "range": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "deck_t": {
              "type": "object",
              "required": [
                "expression",
                "unit",
                "range",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "expression": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "unit": {
                  "const": "mm"
                },
                "range": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "pitch_x": {
              "type": "object",
              "required": [
                "expression",
                "unit",
                "range",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "expression": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "unit": {
                  "const": "mm"
                },
                "range": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "pitch_y": {
              "type": "object",
              "required": [
                "expression",
                "unit",
                "range",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "expression": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "unit": {
                  "const": "mm"
                },
                "range": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "bay_w": {
              "type": "object",
              "required": [
                "expression",
                "unit",
                "range",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "expression": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "unit": {
                  "const": "mm"
                },
                "range": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "bay_d": {
              "type": "object",
              "required": [
                "expression",
                "unit",
                "range",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "expression": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "unit": {
                  "const": "mm"
                },
                "range": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "pad_t": {
              "type": "object",
              "required": [
                "expression",
                "unit",
                "range",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "expression": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "unit": {
                  "const": "mm"
                },
                "range": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "grid": {
          "const": {
            "rows": 3,
            "columns": 3,
            "row_order": "rear_to_front",
            "slot_prefix": "PS01.S"
          }
        },
        "tool_capabilities": {
          "type": "object",
          "required": [
            "tip_supply",
            "selection",
            "channels",
            "minimum_qualified_volume_ul",
            "resolution_ul",
            "dose_accuracy_verified",
            "physical_tip_change_verified",
            "physical_tool_change_verified"
          ],
          "additionalProperties": false,
          "properties": {
            "tip_supply": {
              "allOf": [
                {
                  "$ref": "assembly-reference.schema.json#/$defs/reference"
                },
                {
                  "required": [
                    "source_sha256"
                  ]
                }
              ]
            },
            "selection": {
              "const": "smallest_nominal_capacity"
            },
            "channels": {
              "const": 1
            },
            "minimum_qualified_volume_ul": {
              "type": "null"
            },
            "resolution_ul": {
              "type": "null"
            },
            "dose_accuracy_verified": {
              "const": false
            },
            "physical_tip_change_verified": {
              "const": false
            },
            "physical_tool_change_verified": {
              "const": false
            }
          }
        },
        "qualifications": {
          "const": {
            "robot_motion_implemented": false,
            "hardware_execution_implemented": false,
            "collision_free_working_paths": false,
            "human_speed_comparison": null,
            "tip_box_fit_verified": false,
            "sterility_verified": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "labware": {
      "type": "object",
      "required": [
        "format",
        "id",
        "units",
        "sources",
        "types",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "solidcraftbot.pipetting-labware/1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "const": {
            "length": "mm",
            "volume": "uL"
          }
        },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^cad/vendor/opentrons/[A-Za-z0-9_.-]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "retrieved_on": {
                "type": "string",
                "format": "date"
              },
              "provenance": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "types": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "recipe",
                  "source_id",
                  "color"
                ],
                "additionalProperties": false,
                "properties": {
                  "recipe": {
                    "const": "opentrons_circular_plate/1"
                  },
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[a-fA-F0-9]{6}$"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "recipe",
                  "rows",
                  "columns",
                  "pitch_mm",
                  "inner_size_mm",
                  "wall_mm",
                  "bottom_mm",
                  "capacity_ul",
                  "color",
                  "basis"
                ],
                "additionalProperties": false,
                "properties": {
                  "recipe": {
                    "const": "rectangular_reservoir_grid/1"
                  },
                  "rows": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 26
                  },
                  "columns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 24
                  },
                  "pitch_mm": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "inner_size_mm": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "wall_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "bottom_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "capacity_ul": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[a-fA-F0-9]{6}$"
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "setup": {
      "type": "object",
      "required": [
        "format",
        "id",
        "workspace",
        "assets",
        "labware",
        "tip_stocks",
        "tool_visualization",
        "limitations",
        "handling"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "solidcraftbot.pipetting-setup/1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "allOf": [
            {
              "$ref": "assembly-reference.schema.json#/$defs/reference"
            },
            {
              "required": [
                "source_sha256"
              ]
            }
          ]
        },
        "assets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "assembly-reference.schema.json#/$defs/reference"
              },
              {
                "required": [
                  "source_sha256"
                ]
              }
            ]
          }
        },
        "labware": {
          "type": "array",
          "items": {
            "$ref": "assembly-reference.schema.json#/$defs/instance"
          },
          "minItems": 1
        },
        "tip_stocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "assembly",
              "registration",
              "occupancy"
            ],
            "additionalProperties": false,
            "properties": {
              "assembly": {
                "$ref": "assembly-reference.schema.json#/$defs/instance"
              },
              "registration": {
                "type": "object",
                "required": [
                  "anchor",
                  "mouth_height_above_pad_mm",
                  "basis"
                ],
                "additionalProperties": false,
                "properties": {
                  "anchor": {
                    "const": "tip_grid_center"
                  },
                  "mouth_height_above_pad_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "basis": {
                    "const": "synthetic_setup_assumption"
                  }
                }
              },
              "occupancy": {
                "type": "object",
                "required": [
                  "occupied_slots",
                  "evidence"
                ],
                "additionalProperties": false,
                "properties": {
                  "occupied_slots": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-H](0[1-9]|1[0-2])$"
                    }
                  },
                  "evidence": {
                    "type": "object",
                    "required": [
                      "kind",
                      "reference"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "synthetic_fixture",
                          "owner_statement",
                          "measurement_record"
                        ]
                      },
                      "reference": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "minItems": 1
        },
        "tool_visualization": {
          "type": "object",
          "required": [
            "case_only",
            "mount",
            "basis"
          ],
          "additionalProperties": false,
          "properties": {
            "case_only": {
              "const": true
            },
            "mount": {
              "const": "current_arm_flange"
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "handling": {
          "$ref": "assembly-reference.schema.json#/$defs/reference"
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "format",
        "id",
        "revision",
        "mode",
        "units",
        "setup",
        "materials",
        "initial_liquids",
        "tip_policy",
        "steps",
        "expectations",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "solidcraftbot.pipetting-protocol/1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "const": "planning_only"
        },
        "units": {
          "const": {
            "volume": "uL"
          }
        },
        "setup": {
          "allOf": [
            {
              "$ref": "assembly-reference.schema.json#/$defs/reference"
            },
            {
              "required": [
                "source_sha256"
              ]
            }
          ]
        },
        "materials": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "label",
              "basis"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "const": "synthetic_example"
              }
            }
          }
        },
        "initial_liquids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "location",
              "components_ul",
              "dead_volume_ul"
            ],
            "additionalProperties": false,
            "properties": {
              "location": {
                "type": "object",
                "required": [
                  "labware",
                  "well"
                ],
                "additionalProperties": false,
                "properties": {
                  "labware": {
                    "type": "string",
                    "minLength": 1
                  },
                  "well": {
                    "type": "string",
                    "pattern": "^[A-Z][0-9]{2}$"
                  }
                }
              },
              "components_ul": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "dead_volume_ul": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "minItems": 1
        },
        "tip_policy": {
          "const": "fresh_per_transfer_chunk_or_mix"
        },
        "steps": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "id",
                  "operation",
                  "source",
                  "target",
                  "volume_ul"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operation": {
                    "const": "transfer"
                  },
                  "source": {
                    "type": "object",
                    "required": [
                      "labware",
                      "well"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "labware": {
                        "type": "string",
                        "minLength": 1
                      },
                      "well": {
                        "type": "string",
                        "pattern": "^[A-Z][0-9]{2}$"
                      }
                    }
                  },
                  "target": {
                    "type": "object",
                    "required": [
                      "labware",
                      "well"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "labware": {
                        "type": "string",
                        "minLength": 1
                      },
                      "well": {
                        "type": "string",
                        "pattern": "^[A-Z][0-9]{2}$"
                      }
                    }
                  },
                  "volume_ul": {
                    "type": "number",
                    "minimum": 0
                  },
                  "mix_after": {
                    "type": "object",
                    "required": [
                      "volume_ul",
                      "cycles"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "volume_ul": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "cycles": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "operation",
                  "source",
                  "target",
                  "volumes"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operation": {
                    "const": "distribute"
                  },
                  "source": {
                    "type": "object",
                    "required": [
                      "labware",
                      "well"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "labware": {
                        "type": "string",
                        "minLength": 1
                      },
                      "well": {
                        "type": "string",
                        "pattern": "^[A-Z][0-9]{2}$"
                      }
                    }
                  },
                  "target": {
                    "type": "object",
                    "required": [
                      "labware",
                      "wells"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "labware": {
                        "type": "string",
                        "minLength": 1
                      },
                      "wells": {
                        "oneOf": [
                          {
                            "const": "all"
                          },
                          {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "pattern": "^[A-Z][0-9]{2}$"
                            }
                          }
                        ]
                      }
                    }
                  },
                  "volumes": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "constant_ul"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "constant_ul": {
                            "type": "number",
                            "minimum": 0
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "per_target_ul"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "per_target_ul": {
                            "type": "array",
                            "items": {
                              "type": "number",
                              "minimum": 0
                            },
                            "minItems": 1
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "axis",
                          "values_ul"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "axis": {
                            "enum": [
                              "row",
                              "column"
                            ]
                          },
                          "values_ul": {
                            "type": "array",
                            "items": {
                              "type": "number",
                              "minimum": 0
                            },
                            "minItems": 1
                          }
                        }
                      }
                    ]
                  },
                  "mix_after": {
                    "type": "object",
                    "required": [
                      "volume_ul",
                      "cycles"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "volume_ul": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "cycles": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "operation",
                  "sources",
                  "target",
                  "volumes_ul"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operation": {
                    "const": "consolidate"
                  },
