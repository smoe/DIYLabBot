{
  "type": "object",
  "required": [
    "format",
    "catalog",
    "default_type",
    "default_material",
    "level_materials",
    "round_window_levels",
    "large_outer_room_rule",
    "include_areas",
    "exclude_areas",
    "exclude_label_terms",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "solidcraftbot.building-doors/1"
    },
    "catalog": {
      "type": "object",
      "required": [
        "source",
        "source_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^model/"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "default_type": {
      "enum": [
        "plain",
        "round_window"
      ]
    },
    "default_material": {
      "enum": [
        "wood",
        "steel",
        "glass",
        "blue_black_steel"
      ]
    },
    "level_materials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "KG": {
          "enum": [
            "wood",
            "steel",
            "glass",
            "blue_black_steel"
          ]
        },
        "EG": {
          "enum": [
            "wood",
            "steel",
            "glass",
            "blue_black_steel"
          ]
        },
        "OG1": {
          "enum": [
            "wood",
            "steel",
            "glass",
            "blue_black_steel"
          ]
        },
        "OG2": {
          "enum": [
            "wood",
            "steel",
            "glass",
            "blue_black_steel"
          ]
        },
        "OG3": {
          "enum": [
            "wood",
            "steel",
            "glass",
            "blue_black_steel"
          ]
        }
      }
    },
    "round_window_levels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "EG",
          "OG1",
          "OG2",
          "OG3"
        ]
      }
    },
    "large_outer_room_rule": {
      "type": "object",
      "required": [
        "reference_area",
        "minimum_area_ratio",
        "band_reference_area",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "reference_area": {
          "type": "string"
        },
        "minimum_area_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "band_reference_area": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "include_areas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "KG": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "EG": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "OG1": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "OG2": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "OG3": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        }
      }
    },
    "exclude_areas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "KG": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "EG": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "OG1": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "OG2": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "OG3": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        }
      }
    },
    "exclude_label_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "opening_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level_id",
          "opening_id",
          "type",
          "material",
          "basis"
        ],
        "properties": {
          "level_id": {
            "enum": [
              "KG",
              "EG",
              "OG1",
              "OG2",
              "OG3"
            ]
          },
          "opening_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "type": {
            "enum": [
              "plain",
              "round_window"
            ]
          },
          "material": {
            "enum": [
              "wood",
              "steel",
              "glass",
              "blue_black_steel"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "pose": {
            "type": "object",
            "required": [
              "approach_from",
              "hinge_side",
              "opens_into"
            ],
            "additionalProperties": false,
            "properties": {
              "approach_from": {
                "type": "string",
                "minLength": 1
              },
              "hinge_side": {
                "enum": [
                  "left",
                  "right"
                ]
              },
              "opens_into": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "material": {
                  "const": "glass"
                }
              }
            },
            "then": {
              "properties": {
                "type": {
                  "const": "plain"
                }
              }
            }
          }
        ]
      }
    },
    "laboratory_corridor_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room_assignments",
        "opens_into",
        "hinge",
        "basis"
      ],
      "properties": {
        "room_assignments": {
          "$ref": "#/properties/catalog"
        },
        "opens_into": {
          "const": "corridor"
        },
        "hinge": {
          "const": "preserve_source_interval_start"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "building-doors.schema.json"
}
