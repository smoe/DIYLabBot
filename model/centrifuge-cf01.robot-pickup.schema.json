{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "centrifuge-cf01.robot-pickup.schema.json",
  "title": "CF01 scene references and arm length variant",
  "type": "object",
  "required": [
    "format",
    "sources",
    "arm_fixture",
    "environment",
    "rack"
  ],
  "properties": {
    "format": {
      "const": "solidcraftbot.centrifuge-robot-pickup/1"
    },
    "sources": {
      "type": "object",
      "required": [
        "protocol"
      ],
      "properties": {
        "protocol": {
          "const": "model/centrifuge-cf01.protocol.json"
        }
      },
      "additionalProperties": false
    },
    "arm_fixture": {
      "type": "object",
      "required": [
        "mounting",
        "calibrated",
        "changes_lab_layout",
        "fastening_qualified"
      ],
      "additionalProperties": false,
      "properties": {
        "mounting": {
          "const": "direct_to_bench"
        },
        "calibrated": {
          "const": false
        },
        "changes_lab_layout": {
          "const": false
        },
        "fastening_qualified": {
          "const": false
        }
      }
    },
    "environment": {
      "$ref": "assembly-reference.schema.json#/$defs/reference"
    },
    "rack": {
      "type": "object",
      "required": [
        "selected_slot",
        "approach_grip_height_mm"
      ],
      "additionalProperties": false,
      "properties": {
        "selected_slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "approach_grip_height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "not": {
    "required": [
      "bench_surface"
    ]
  }
}
