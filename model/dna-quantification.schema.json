{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidcraftbot.local/schema/dna-quantification-profile/1",
  "title": "Sequential DNA NanoDrop/Qubit-HS synthetic run profile",
  "type": "object",
  "required": [
    "format",
    "id",
    "mode",
    "protocol",
    "device_profiles",
    "rack",
    "dilution_rack",
    "samples",
    "parameters",
    "diluent",
    "assumptions"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "solidcraftbot.dna-quantification-profile/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "synthetic_only"
    },
    "protocol": {
      "$ref": "#/$defs/sourceReference"
    },
    "device_profiles": {
      "type": "object",
      "required": [
        "nanodrop",
        "qubit"
      ],
      "additionalProperties": false,
      "properties": {
        "nanodrop": {
          "$ref": "#/$defs/sourceReference"
        },
        "qubit": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "rack": {
      "type": "object",
      "required": [
        "id",
        "definition"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "dilution_rack": {
      "type": "object",
      "required": [
        "id",
        "definition"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "vessel_id",
          "rack_slot",
          "initial_volume_ul"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "vessel_id": {
            "type": "string",
            "minLength": 1
          },
          "rack_slot": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "initial_volume_ul": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nanodrop_sample_volume_ul",
        "qubit_sample_volume_ul",
        "dilution_sample_volume_ul",
        "task_deadline_s",
        "synthetic_calibration_validity_s"
      ],
      "properties": {
        "nanodrop_sample_volume_ul": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "qubit_sample_volume_ul": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dilution_sample_volume_ul": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "task_deadline_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "synthetic_calibration_validity_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "diluent": {
      "type": "object",
      "required": [
        "id",
        "qualification"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assumptions": {
      "const": {
        "input_rack_delivered_on_table": true,
        "return_policy": "original_rack_place",
        "new_dilutions_from_original_only": true
      }
    }
  },
  "$defs": {
    "sourceReference": {
      "type": "object",
      "required": [
        "source",
        "source_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^model/"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
