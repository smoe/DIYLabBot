{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "furniture-catalog.schema.json",
  "title": "Portable parameterized furniture types without room positions",
  "type": "object",
  "required": [
    "format",
    "units",
    "types"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "solidcraftbot.furniture-catalog/1"
    },
    "units": {
      "const": {
        "length": "mm",
        "angle": "deg"
      }
    },
    "types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "recipe",
          "parameters"
        ],
        "additionalProperties": false,
        "properties": {
          "recipe": {
            "enum": [
              "storage_bench",
              "open_shaped_bench",
              "box_envelope",
              "side_gap_cover",
              "support_gap_cover"
            ]
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "unit",
                "range"
              ],
              "additionalProperties": false,
              "properties": {
                "unit": {
                  "const": "mm"
                },
                "range": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "leg_fractions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "enum": [
                "floor_outline"
              ]
            }
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "recipe": {
                  "const": "box_envelope"
                }
              }
            },
            "then": {
              "required": [
                "role",
                "color"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "recipe": {
                  "const": "open_shaped_bench"
                }
              }
            },
            "then": {
              "required": [
                "leg_fractions"
              ]
            }
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
