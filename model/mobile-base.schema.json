{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolidCraftBot external mobile arm assembly v1",
  "type": "object",
  "required": ["format", "id", "status", "units", "arm_source", "parameters", "recipe", "poses", "protocol", "vision", "qualification", "checks", "limitations"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "solidcraftbot.mobile-arm/1"},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
    "status": {"const": "concept_not_for_manufacture"},
    "units": {"const": {"length": "mm", "angle": "deg", "time": "s"}},
    "arm_source": {"const": "model/robot.json"},
    "parameters": {"type": "object", "additionalProperties": {"type": "object", "required": ["unit", "expression", "range"], "additionalProperties": false,
      "properties": {"unit": {"const": "mm"}, "expression": {"type": ["number", "string"]}, "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}}},
    "recipe": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["id", "action", "part"],
      "properties": {"id": {"type": "string"}, "action": {"enum": ["manual_mobile_base", "retractable_support_tripod", "repositioning_handle"]}, "part": {"type": "null"},
        "caster_count": {"const": 4}, "drive": {"const": "manual"}, "adjustment": {"const": "three_independent_manual_thumbwheels"}, "screw_lead_mm": {"type": "null"}, "side": {"const": "rear"}}, "additionalProperties": false}},
    "poses": {"type": "object", "required": ["working", "parking_supported", "manual_reposition", "parked_aside"], "additionalProperties": {"$ref": "#/$defs/pose"}},
    "protocol": {"type": "object", "required": ["id", "status", "steps", "fault_response"], "additionalProperties": false,
      "properties": {"id": {"const": "MB01.YieldAndResume"}, "status": {"const": "design_contract_no_hardware_execution"}, "fault_response": {"type": "string"},
        "steps": {"type": "array", "minItems": 6, "items": {"type": "object", "required": ["id", "requires", "pose"], "additionalProperties": false,
          "properties": {"id": {"type": "string"}, "requires": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "pose": {"enum": ["working", "parking_supported", "manual_reposition", "parked_aside"]}, "duration_s": {"type": ["number", "null"], "minimum": 0}}}}}},
    "vision": {"type": "object", "required": ["controlled_relationship", "global_base_precision_required", "precision_dock_required", "localization_invalidated_by_manual_move", "image_topics_implemented", "visual_servo_implemented", "position_tolerance_mm", "orientation_tolerance_deg", "maximum_image_age_s", "reacquisition_time_s"], "additionalProperties": false,
      "properties": {"controlled_relationship": {"const": "actual_pipette_tip_to_actual_tube_position_and_orientation"}, "global_base_precision_required": {"const": false}, "precision_dock_required": {"const": false}, "localization_invalidated_by_manual_move": {"const": true}, "image_topics_implemented": {"const": false}, "visual_servo_implemented": {"const": false},
        "position_tolerance_mm": {"type": ["number", "null"], "exclusiveMinimum": 0}, "orientation_tolerance_deg": {"type": ["number", "null"], "exclusiveMinimum": 0}, "maximum_image_age_s": {"type": ["number", "null"], "exclusiveMinimum": 0}, "reacquisition_time_s": {"type": ["number", "null"], "minimum": 0}}},
    "qualification": {"type": "object", "required": ["manufacturing_released"], "properties": {"manufacturing_released": {"const": false}}, "additionalProperties": {"type": ["number", "array", "string", "null"]}},
    "checks": {"type": "object", "required": ["fold_sample_step_deg", "overlap_threshold_mm3"], "additionalProperties": false,
      "properties": {"fold_sample_step_deg": {"type": "number", "exclusiveMinimum": 0}, "overlap_threshold_mm3": {"const": 0.0001}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {"pose": {"type": "object", "required": ["arm_deg", "supports", "manual_xy_yaw"], "additionalProperties": false,
    "properties": {"arm_deg": {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6}, "supports": {"enum": ["deployed", "retracted"]},
      "manual_xy_yaw": {"description": "x/y in mm, yaw in deg; illustrative manual location", "type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}}}}
}
