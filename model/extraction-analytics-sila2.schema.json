          "source_sha256": "d1c3752a23b56f0464bf1511d84e0a39f107c17290cba4568e0b6015b52dddb6",
          "upstream_path": "feature_definitions/org/silastandard/core/AuthenticationService-v1_0.sila.xml"
        },
        {
          "identifier": "AuthorizationService",
          "source": "interfaces/sila2/standard/AuthorizationService-v1_0.sila.xml",
          "source_sha256": "cf7dd469fd034b1a32e14782853ff6cdd95af323dffc08a1887958d5cd73f3f6",
          "upstream_path": "feature_definitions/org/silastandard/core/AuthorizationService-v1_0.sila.xml"
        }
      ]
    },
    "runtime_sources": {
      "const": [
        "scripts/build_extraction_analytics_sila2.py",
        "scripts/extraction_analytics_sila2_control.py",
        "scripts/extraction_analytics_sila2_runtime.py",
        "scripts/extraction_analytics_sila2_execution.py",
        "scripts/dna_sila2_server.py",
        "scripts/dna_sila2_runtime.py",
        "scripts/run_dna_sila2.py",
        "scripts/build_dna_quantification_sila2.py",
        "scripts/cf01_sila2_auth.py",
        "scripts/cf01_sila2_client.py",
        "scripts/dna_quantification_control.py"
      ]
    },
    "families": {
      "type": "object",
      "required": [
        "dneasy",
        "puregene"
      ],
      "additionalProperties": false,
      "properties": {
        "dneasy": {
          "$ref": "#/$defs/reference"
        },
        "puregene": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "analytics_protocol": {
