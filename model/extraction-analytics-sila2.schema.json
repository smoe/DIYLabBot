          "upstream_path": "feature_definitions/org/silastandard/core/LockController-v1_0.sila.xml"
        },
        {
          "identifier": "CancelController",
          "source": "interfaces/sila2/standard/CancelController-v1_0.sila.xml",
          "source_sha256": "d1ac2002e1ff38f752debe59c667ebd2a9a6a65c0a11664643f83d33ad60a7e4",
          "upstream_path": "feature_definitions/org/silastandard/core/commands/CancelController-v1_0.sila.xml"
        },
        {
          "identifier": "SimulationController",
          "source": "interfaces/sila2/standard/SimulationController-v1_0.sila.xml",
          "source_sha256": "f96abd91e60cef32cdf8d515665f5f3d53b9018d9f4799ceae7d81d86c04a543",
          "upstream_path": "feature_definitions/org/silastandard/core/SimulationController-v1_0.sila.xml"
        },
        {
