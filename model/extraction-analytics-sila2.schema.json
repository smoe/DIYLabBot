{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solidcraftbot.local/schema/extraction-analytics-sila2/1",
  "title": "Additive synthetic extraction analytics SiLA feature",
  "type": "object",
  "required": [
    "format",
    "id",
    "mode",
    "simulation_only",
    "hardware_available",
    "families",
    "analytics_protocol",
    "standard_provenance",
    "feature",
    "commands",
    "standard_features",
    "runtime_sources",
    "publish_interval_s",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "solidcraftbot.extraction-analytics-sila2/1"
    },
    "id": {
      "const": "Extraction.Analytics.SiLA2"
    },
    "mode": {
      "const": "synthetic_only"
    },
    "simulation_only": {
      "const": true
    },
    "hardware_available": {
      "const": false
    },
    "feature": {
      "const": {
        "identifier": "ExtractionAnalyticsWorkflow",
        "originator": "org.solidcraftbot",
        "category": "analytics",
        "version": "1.0",
        "sila_version": "1.1",
        "maturity": "Draft",
        "locale": "en-us"
      }
    },
    "commands": {
      "const": [
        {
          "name": "CreateRun",
          "observable": false,
          "arguments": [
            {
              "name": "request_identifier",
              "type": "string",
              "description": "Unique opaque identifier for a durable atomic root receipt; exact repeats return the stored response."
            },
            {
              "name": "run_identifier",
              "type": "string",
              "description": "Explicit integrated extraction root identity; never infer a run from time or order."
            },
            {
              "name": "family_identifier",
              "type": "string",
              "description": "Bind the known dneasy or puregene composition and its fixed synthetic fixture to this root at creation."
            }
          ]
        },
        {
          "name": "RunUntilDecision",
          "observable": true,
          "arguments": [
            {
              "name": "request_identifier",
              "type": "string",
              "description": "Unique opaque identifier for a durable atomic root receipt; exact repeats return the stored response."
            },
            {
              "name": "run_identifier",
              "type": "string",
              "description": "Explicit integrated extraction root identity; never infer a run from time or order."
            }
          ]
        },
        {
          "name": "ResumeRun",
          "observable": false,
          "arguments": [
            {
              "name": "request_identifier",
              "type": "string",
              "description": "Unique opaque identifier for a durable atomic root receipt; exact repeats return the stored response."
            },
            {
              "name": "run_identifier",
              "type": "string",
              "description": "Explicit integrated extraction root identity; never infer a run from time or order."
            },
            {
              "name": "resume",
              "type": "bool",
              "description": "Explicit session takeover choice; open effects still require reconciliation."
            }
          ]
        },
        {
          "name": "ReconcileRun",
          "observable": false,
          "arguments": [
            {
              "name": "request_identifier",
              "type": "string",
              "description": "Unique opaque identifier for a durable atomic root receipt; exact repeats return the stored response."
            },
            {
              "name": "run_identifier",
              "type": "string",
              "description": "Explicit integrated extraction root identity; never infer a run from time or order."
            },
            {
              "name": "observation_json",
              "type": "string",
              "description": "Bounded versioned explicit complete root observations and pending-effect resolutions; not an automatically generated observation."
            }
          ]
        },
        {
          "name": "CancelRun",
          "observable": false,
          "arguments": [
            {
              "name": "request_identifier",
              "type": "string",
              "description": "Unique opaque identifier for a durable atomic root receipt; exact repeats return the stored response."
            },
            {
              "name": "run_identifier",
              "type": "string",
              "description": "Explicit integrated extraction root identity; never infer a run from time or order."
            },
            {
              "name": "reason",
              "type": "string",
              "description": "Explicit reason for requesting controlled root cancellation; acceptance is not resource release."
            }
          ]
        },
        {
          "name": "FinishCancel",
          "observable": false,
          "arguments": [
            {
              "name": "request_identifier",
              "type": "string",
              "description": "Unique opaque identifier for a durable atomic root receipt; exact repeats return the stored response."
            },
            {
              "name": "run_identifier",
              "type": "string",
              "description": "Explicit integrated extraction root identity; never infer a run from time or order."
            },
            {
              "name": "observation_json",
              "type": "string",
              "description": "Bounded versioned complete final observations and explicit material dispositions; unresolved effects retain resources."
            }
          ]
        }
      ]
    },
    "standard_features": {
      "const": [
        {
          "identifier": "SiLAService",
